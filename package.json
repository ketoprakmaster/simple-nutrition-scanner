{
	"name": "svelte-latest",
	"private": true,
	"version": "1.2.0-pwa",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:serve": "cross-env BASE_PATH='/myapp' && bun run build && bun run preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run tests/apiIngestion.live.test.ts",
		"generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 static/favicon.svg"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@vite-pwa/assets-generator": "^1.0.4",
		"cross-env": "^10.1.0",
		"daisyui": "^5.7.50",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@ericblade/quagga2": "^1.12.1",
		"@lucide/svelte": "^0.575.0",
		"dexie": "^4.4.6",
		"workbox-core": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1"
	}
}
